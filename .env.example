# ==============================================================================
# WorkerShield AI - Environment Configuration Template
# Copy this file to '.env' and update with your local environment values
# ==============================================================================

# Node.js Express API Gateway (Port 5000)
PORT=5000
JWT_SECRET=super_secret_workershield_jwt_key

# Python Flask AI Service (Port 8000 with Waitress WSGI)
AI_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=worker_safety
DB_SSL=false

# Application File & Model Paths (relative to project root)
UPLOAD_FOLDER=uploads
VIOLATION_FOLDER=violation_data
MODEL_PATH=models/yolov8s_ppe_custom.pt

# Telegram Bot Alert Configuration
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Alert Cooldown Duration (seconds between duplicate alerts per location & violation)
NOTIFICATION_COOLDOWN=60

# Optional Email / SMTP Alert Configuration
EMAIL_ENABLED=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_RECIPIENT_EMAIL=supervisor@example.com

# PPE Model Class Mapping & Violation Definitions
PPE_CLASS_MAPPING='{"0": "person", "1": "Hardhat", "2": "Mask", "3": "NO-Hardhat", "4": "NO-Mask", "5": "NO-Safety Vest", "6": "Person", "7": "Safety Cone", "8": "Safety Vest", "9": "machinery", "10": "vehicle"}'
VIOLATION_CLASSES='["NO-Hardhat", "NO-Mask", "NO-Safety Vest"]'
AREA_REQUIREMENTS='{"default": ["Hardhat", "Safety Vest"], "construction": ["Hardhat", "Safety Vest"], "lab": ["Mask"]}'
